{
	"name": "journy",
	"version": "2.0.0",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"puzzles": "tsx scripts/puzzles.ts",
		"map": "tsx scripts/build-map.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.0",
		"@skeletonlabs/skeleton": "^5.0.1",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/canvas-confetti": "^1.9.0",
		"@types/d3-geo": "^3.1.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^24",
		"@types/topojson-client": "^3.1.5",
		"@types/topojson-simplify": "^3.0.3",
		"@types/topojson-specification": "^1.0.5",
		"d3-geo": "^3.1.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"topojson-client": "^3.1.0",
		"topojson-simplify": "^3.0.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"us-atlas": "^3.0.1",
		"vite": "^8.3.4",
		"vitest": "^4.1.8"
	},
	"type": "module",
	"dependencies": {
		"@fontsource/abril-fatface": "^5.3.0",
		"@fontsource/gloria-hallelujah": "^5.3.0",
		"@tabler/icons-svelte-runes": "^3.49.0",
		"canvas-confetti": "^1.9.4"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22.17 <25"
	}
}
